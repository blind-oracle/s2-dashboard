# Project defaults - applied when sdkconfig.<env> is generated. Edit the generated
# file (or run `pio run -t menuconfig`) for local tweaks; change this file for
# defaults everyone should get.

# Waveshare ESP32-S3-Zero: 4 MB flash, 2 MB quad PSRAM, native USB only.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Console on the USB Serial/JTAG controller (the board has no UART bridge).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 1 ms tick for timestamp/scheduling granularity.
CONFIG_FREERTOS_HZ=1000

# Faster code, still with asserts.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Bigger main task stack (decoder tables + printf).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Keep info logs; the logger uses plain printf for data lines.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n

# The BLE controller needs the IRAM this was holding, and the TWAI ISR in IRAM
# is a latency optimisation rather than a requirement: the driver's RX queue
# absorbs the difference at 500 kbit/s.
CONFIG_TWAI_ISR_IN_IRAM=n

# Bluetooth LE. The ESP32-S3 has no Bluetooth Classic radio, so BLE is the only
# option; NimBLE is roughly half of Bluedroid's footprint and this is a
# peripheral-only role.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Peripheral and broadcaster only: no scanning, no central role.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# One phone at a time. A 247-byte MTU carries 29 snapshot records per
# notification, so a full 113-signal snapshot takes four.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# No bonding: the service is read-only telemetry and the command channel cannot
# reach the CAN bus, so there is nothing to protect and no NVS writes at runtime.
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# Keep core 1 free for the CAN decoder task.
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y

# Moves the controller out of ROM and IRAM into flash. Measured on this project:
# 16.8 KB less DIRAM (110.3 KB vs 127.1 KB used) for 110 KB more flash (754 KB
# vs 643 KB). Worth it because runtime DIRAM is the scarce resource once the
# 134 KB framebuffer is allocated, and because running out of flash fails the
# build visibly whereas running out of heap fails at runtime inside the BLE
# stack.
#
# The documented caveat is degraded Bluetooth while flash is being erased. OTA
# does erase flash, so that is no longer hypothetical. It is handled by entering
# update mode through a reboot with BLE never started, so no flash-resident
# controller code is running while sectors are erased. See src/ota.c.
#
# The CAN ISR, which CONFIG_TWAI_ISR_IN_IRAM=n above also leaves in flash, DOES
# keep running in update mode: the handlebar button arrives over CAN and is the
# only way to cancel. Losing frames to a flash erase costs nothing while parked
# and cannot disturb a bus the firmware never acknowledges.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y

# Over-the-air updates. The partition table itself is selected by
# board_build.partitions in platformio.ini, which is what the PlatformIO espidf
# builder actually reads; this option only keeps menuconfig honest about it.
# Two 1700 KB app slots: nvs 24K at 0x9000 (unmoved from the single-app table,
# so the one-time wired migration preserves it), otadata 8K, phy_init 4K,
# ota_0 at 0x20000, ota_1 at 0x1d0000, 540 KB spare.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Run a newly flashed image on probation: if it does not call
# esp_ota_mark_app_valid_cancel_rollback() the next boot reverts to the slot that
# was working before. A panic or a watchdog before that point rolls back on its
# own, which is the failure this protects against.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Keep the Wi-Fi hot paths in IRAM. These default to y on the S3 and must stay
# that way: turning them off saves ~27 KB of IRAM but moves Wi-Fi code into
# flash, and update mode erases flash while the Wi-Fi radio is serving the
# upload. That is the one workload where flash-resident radio code starves.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# One phone at a time on the update access point; no station mode is used.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# Drop PHY transmit power to the lowest table entry on any boot that follows a
# brownout. Off by default upstream. On a vehicle supply this is the right
# reflex: if the rail already collapsed once, the radio should not immediately
# ask for the largest peak current on the board again.
CONFIG_ESP_PHY_REDUCE_TX_POWER=y

# ---------------------------------------------------------------- project ---
# Project options whose Kconfig default is NOT what this bike runs. Everything
# else in the S2 Dashboard menu is left at its Kconfig default, so only the
# genuine deviations live here.
#
# These used to exist solely in the generated sdkconfig, which is committed even
# though it is gitignored. That made the generated file load-bearing, and
# regenerating it against a new ESP-IDF silently reverted all three. Keeping
# them here instead means the generated file can be deleted and rebuilt freely.

# Leave listen-only mode OFF. It defaults ON, and deliberately so: a passive tap
# cannot disturb the motorcycle's bus. This bike has been verified decoding
# broadcast frames cleanly, and UDS polling below requires transmitting, so the
# tap is allowed to ACK. S2_UDS_ENABLE has "depends on !S2_CAN_LISTEN_ONLY", so
# with this line missing the entire UDS menu vanishes from the config rather
# than merely turning off - which is how it silently disappeared once already.
CONFIG_S2_CAN_LISTEN_ONLY=n

# Poll the BCM gateway with UDS. Off upstream because it transmits, and this is
# otherwise a listen-only tap; on here because state of health, GPS and the
# cellular parameters have no broadcast source at all.
CONFIG_S2_UDS_ENABLE=y

# Also poll the TCU (0x7D4), the only source of GPS position on this bike.
CONFIG_S2_UDS_POLL_TCU=y

# Hold the handlebar info button for 5 s to enter update mode, not the 2 s
# default: 2 s is short enough to trigger while paging through screens.
CONFIG_S2_OTA_LONG_PRESS_MS=5000

# Tyre pressure in bar rather than the PSI default.
CONFIG_S2_DISPLAY_PRESSURE_BAR=y

# No hex dump of every UDS response. It defaults on, which is right while
# bringing the poller up and far too noisy once it works: the catalog is walked
# every 5 s and the dump competes with the signal-change log for the queue.
CONFIG_S2_UDS_LOG_RAW=n
